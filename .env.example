# AI 内容创作工作台 - 环境变量示例
# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 排除，不会提交。
# 也可在应用内 /settings 页面配置（存数据库，AES-256-GCM 加密）。
# 数据库配置优先级高于 .env。

# ===== 引擎 API Key =====
# DeepSeek（提示词生成 / 品牌客服回复）
DEEPSEEK_KEY=sk-xxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# 可灵（图像 + 视频）
KLING_AK=xxxxxxxx          # 新版单 API Key 只填这栏
KLING_SK=                  # 旧版双 KEY 才填 Secret Key，否则留空
KLING_BASE=https://api-beijing.klingai.com
KLING_MODEL=kling-v2

# 通义万相（图像，走阿里云百炼 dashscope）
WANXIANG_KEY=sk-xxxxxxxx
WANXIANG_MODEL=wanx2.1-t2i-turbo

# 即梦 Seedream（图像，走火山方舟）
JIMENG_KEY=xxxxxxxx
JIMENG_MODEL=doubao-seedream-5-0-pro

# Vidu（视频）
VIDU_KEY=xxxxxxxx
VIDU_BASE=https://api.vidu.cn
VIDU_MODEL=viduq3-pro
VIDU_RESOLUTION=720p

# LOVART（图像，需代理）
LOVART_AK=xxxxxxxx
LOVART_SK=xxxxxxxx
LOVART_BASE=https://lgw.lovart.ai
LOVART_PATH=/v1/openapi
LOVART_PROJECT_ID=         # 留空则首次出图自动创建

# 通义千问 VL（图像理解 / 反推提示词）
QWEN_VL_KEY=sk-xxxxxxxx
QWEN_VL_MODEL=qwen-vl-max

# ===== 应用 =====
# 端口
PORT=3100
